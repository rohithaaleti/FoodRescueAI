PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=foodrescue_ai
JWT_SECRET=your_jwt_secret_key
FRONTEND_ORIGIN=http://localhost:5173

# Smart NGO Matching - AI Recommendation Layer
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key
AI_MODEL=gemini-1.5-flash
AI_API_URL=
AI_TIMEOUT_MS=5000

# Rate Limiting & Abuse Prevention
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_LOGIN_WINDOW_MS=900000
RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_AUTH_REGISTER_WINDOW_MS=900000
RATE_LIMIT_AUTH_REGISTER_MAX=10
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=30
